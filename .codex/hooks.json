{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/test-must-use-docker.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_local_test_scope.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_long_job_timeout.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/check_main_fresh_before_worktree.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/remind_main_sync.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_gh_body_file.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_no_local_paths.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_milestone_gate_approval.sh\" codex"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_milestone_ready_evidence.sh\" codex"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_main_checkout_readonly.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_codex_round_cap.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_scope_on_guard_issues.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_tdd_commit.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_issue_milestone.sh\""
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/enforce_no_attribution.sh\""
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hook/codex_apply_patch.sh\""
          }
        ]
      }
    ]
  }
}
