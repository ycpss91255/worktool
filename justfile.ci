# justfile.ci - worktool CI entry points
#
# Invoke with `just -f justfile.ci <recipe>` (mirrors init_ubuntu's calling
# convention; the bare `justfile` stays the user-facing, auto-discovered one).
#
# Every gate runs inside Docker (doc/design.md: Docker only). These recipes
# are a thin wrapper over ./script/ci/ci.sh, which builds the test image and
# runs the gate in a throwaway container against a bind-mounted /source.

# Show available recipes.
default:
    @just -f justfile.ci --list

# Build the test image (worktool-test:local). Optional - the gates build it
# on demand; useful to warm the cache or fail fast on a broken Dockerfile.
build:
    ./script/ci/ci.sh --build

# ShellCheck over all *.sh and *.bats, inside the container.
lint:
    ./script/ci/ci.sh --lint-only

# Run unit bats (test/unit/*.bats) inside the container.
test-unit:
    ./script/ci/ci.sh --unit-only

# Run integration bats (test/integration/*.bats) inside the container.
test-integration:
    ./script/ci/ci.sh --integration-only

# Run system bats, shim group (test/system/*.bats except real_engine_spec)
# inside the container: the real pinned distrobox against the fake
# container-manager shim (no docker-in-docker). Fast.
test-system:
    ./script/ci/ci.sh --system-only

# Run system bats, real-engine group (test/system/real_engine_spec.bats) in
# the dedicated docker-in-docker runner (dockerfile/Dockerfile.system-real,
# started with `docker run --rm --privileged` - the ONLY privileged recipe):
# a real dockerd inside the runner, the real pinned distrobox assembles the
# delivered box/dev.ini into a real dev box (ubuntu:26.04 + ripgrep fzf) and
# enters it. Slow (image pull + apt inside the box: minutes). Zero leftover
# on the host daemon.
test-system-real:
    ./script/ci/ci.sh --system-real-only

# Run acceptance bats (test/acceptance/*.bats) inside the container: the
# delivered public entry point (script/selfcheck.sh) against the delivered
# repo.
test-acceptance:
    ./script/ci/ci.sh --acceptance-only

# Convenience: all six gates in sequence (test-system-real last: it is the
# slow one).
test: lint test-unit test-integration test-system test-acceptance test-system-real
