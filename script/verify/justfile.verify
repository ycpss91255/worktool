# Acceptance verification namespace. Recipes are added with their checks.
set working-directory := '../..'
set positional-arguments

# List available checks; listing does not run verification.
default:
    @just --justfile '{{source_file()}}' --list
    @echo 'NOTE: listing checks does not run verification.'

# Check the repository diagrams (args: ITEM, --root <repo>, --list, --realbox, --help).
diagram *args:
    ./script/verify/diagram.sh "$@"

# Check the box namespace interface (args: ITEM, --list, --help).
ui *args:
    ./script/verify/ui.sh "$@"

# Check setup and status in a temporary HOME (args: ITEM, --list, --allow-real-box, --help).
setup *args:
    ./script/verify/setup.sh "$@"

# Check the M3 external CI and process evidence (args: ITEM, --list, --help).
evidence *args:
    ./script/verify/evidence.sh "$@"

# Check the automated gates and their evidence (args: ITEM, --list, --help).
gate *args:
    ./script/verify/gate.sh "$@"

# Run real-machine acceptance checks (requires --allow-real-box for execution).
realbox *args:
    ./script/verify/realbox.sh "$@"

# Run every non-real-machine acceptance group (args: --list, --help).
all *args:
    ./script/verify/all.sh "$@"
