# justfile.box - the `box` namespace of the worktool just interface.
#
# `mod?`d by the root justfile as `box`: `just box` lists the box verbs,
# `just box assemble [args]` forwards to ./script/box/assemble.sh,
# `just box bench [args]` to ./script/box/bench.sh, `just box setup [args]`
# to ./script/box/setup.sh, `just box status [args]` to
# ./script/box/status.sh and `just box enter [args]` to
# ./script/box/enter.sh. Base model (ycpss91255-docker/base
# ADR-00000005/10/11): thin forwarders only - `set positional-arguments` +
# "$@" hands the arguments over VERBATIM (argv boundaries intact), nothing
# is validated here and no usage text lives here: `just box help` runs each
# script's --help in turn, and an unknown option is refused by the script
# itself (`<script>.sh: unknown option '<x>' (see --help)`, exit 2). M2 had
# assemble as the only verb; M3 adds bench (#150, #162), setup / status (#21),
# enter (#180) and later rm.
#
# The one-line comment above each recipe is what `just --list` shows.

# Recipes run from the repo root (relative ./script/..., box/dev.ini),
# whether reached via the `box` module or a direct `just -f`. `../..` is
# relative to this file's directory (script/box), i.e. the repo root.
set working-directory := '../..'

# Expose the recipe arguments as "$@" so `*args` is forwarded per argument,
# not re-split by the shell.
set positional-arguments

# source_file() is THIS module's file: inside a mod?'d module `justfile`
# resolves to the root entry, so listing that would show the namespaces
# instead of the box verbs.
# List the box verbs.
default:
    @just --justfile '{{source_file()}}' --list

# Assemble the dev box from its manifest (args: --dry-run, --file <manifest>, --home <path>, --help; default box/dev.ini, ~/<box>-box).
assemble *args:
    ./script/box/assemble.sh "$@"

# Measure the enter latency of the dev box: enter, shell and in-box shell start-up (args: --box NAME, --runs N, --warmup N, --max-ms N, --json, --shell CMD, --help; the script validates --box / --shell).
bench *args:
    ./script/box/bench.sh "$@"

# Choose how a new terminal enters the box (args: --auto-enter yes|no, --terminal ghostty|none, --box <name>, --distrobox <path>, --dry-run, --help).
setup *args:
    ./script/box/setup.sh "$@"

# Show the auto-enter decisions in force, their sources and the managed blocks (args: --help).
status *args:
    ./script/box/status.sh "$@"

# Enter the box; a first launch shows progress, a log and a timeout (args: --box NAME, --distrobox PATH, --timeout SECONDS, -- CMD..., --help).
enter *args:
    ./script/box/enter.sh "$@"

alias h := help

# Show every box script's help (assemble.sh, bench.sh, setup.sh, status.sh, enter.sh --help).
help:
    ./script/box/assemble.sh --help
    ./script/box/bench.sh --help
    ./script/box/setup.sh --help
    ./script/box/status.sh --help
    ./script/box/enter.sh --help
