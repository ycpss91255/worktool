# Dockerfile.test - lightweight lint/test image for worktool (M1/M2)
#
# Bundles bash + bats (+ bats-support / bats-assert) + shellcheck + just + a
# pinned real distrobox so the whole test pyramid runs in Docker only
# (doc/design.md test strategy). Modelled on init_ubuntu's test-tools image,
# stripped to essentials: no kcov, fish, TUI, gum, or module-lifecycle
# tooling.
#
# just (M2): `just` IS the user interface - the repo-root justfile mod?s the
# `test` and `box` namespaces (script/test/justfile.test,
# script/box/justfile.box: `just test unit`, `just box assemble`, ...). The
# alpine package is enough for the unit spec that exercises them
# (test/unit/justfile_spec.bats: --list / real dispatch against stubbed
# scripts); the justfiles must stay within what that packaged version and
# just >= 1.53 on the host both support (mod?, source_file(),
# set working-directory, set positional-arguments).
#
# distrobox (system tier, M2): the upstream release is a bundle of POSIX
# shell scripts, so it runs on alpine as-is. It is installed with its own
# `install` script and pointed at a FAKE container manager by the system
# tests (test/system/) - no docker daemon and no docker-in-docker needed.
#
# Usage:
#   docker build -t worktool-test:local -f dockerfile/Dockerfile.test .
#   docker run --rm -v "$PWD:/source" -w /source worktool-test:local \
#     ./script/test/test.sh --ci-unit

# Single source of truth for the pinned distrobox release (also exported as
# ENV DISTROBOX_VERSION in the final stage so specs can assert on it).
ARG DISTROBOX_VERSION=1.8.2.5
ARG DISTROBOX_SHA256=0c3bc4785ee3be3b89f93abb7cc0a9f60e56989e81319af140a4b60403b18f80

FROM bats/bats:latest AS bats-src

FROM alpine:latest AS bats-extensions
# hadolint ignore=DL3018
RUN apk add --no-cache git && \
    git clone --depth 1 -b v0.3.0 \
        https://github.com/bats-core/bats-support /bats/bats-support && \
    git clone --depth 1 -b v2.1.0 \
        https://github.com/bats-core/bats-assert /bats/bats-assert

FROM alpine:latest AS lint-tools
# TARGETARCH is auto-populated by BuildKit (docker 23+). Do NOT set a
# default - a default shadows BuildKit's auto-inject (moby/buildkit#3403).
ARG TARGETARCH
# hadolint ignore=DL3018
RUN apk add --no-cache curl xz && \
    case "${TARGETARCH}" in \
      amd64)  sc_arch="x86_64" ;; \
      arm64)  sc_arch="aarch64" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL \
        "https://github.com/koalaman/shellcheck/releases/download/v0.10.0/shellcheck-v0.10.0.linux.${sc_arch}.tar.xz" \
        | tar -xJ -C /tmp && \
    mv "/tmp/shellcheck-v0.10.0/shellcheck" /usr/local/bin/shellcheck

# Pinned distrobox release: fetch the tagged source archive, verify its
# checksum, and install the script bundle with upstream's own installer
# (arch-independent; only the distrobox-* scripts are carried forward).
FROM alpine:latest AS distrobox-src
ARG DISTROBOX_VERSION
ARG DISTROBOX_SHA256
# hadolint ignore=DL3018
RUN apk add --no-cache curl coreutils && \
    curl -fsSL -o /tmp/distrobox.tar.gz \
        "https://github.com/89luca89/distrobox/archive/refs/tags/${DISTROBOX_VERSION}.tar.gz" && \
    echo "${DISTROBOX_SHA256}  /tmp/distrobox.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/distrobox.tar.gz -C /tmp && \
    cd "/tmp/distrobox-${DISTROBOX_VERSION}" && \
    ./install --prefix /opt/distrobox

# Final stage.
FROM alpine:latest
ARG DISTROBOX_VERSION
# bash    - bats and worktool shell scripts need it
# git     - test fixtures / future harness
# grep + coreutils - GNU variants so `grep -P` etc. behave like the targets;
#           distrobox's host-side scripts also rely on GNU `base64 -w`,
#           `realpath`, `id -r*`, `mktemp -u`
# ncurses - `tput`-style terminal queries stay sane under a non-tty harness
# just    - the user-facing task runner (root justfile + the test / box
#           namespace modules); exercised by test/unit/justfile_spec.bats,
#           never used to launch the gates from inside the container
# jq      - the Claude Code hooks under .agents/hook/ read their stdin JSON
#           payload with jq (as they do on the host); their specs under
#           test/unit/hook/ build those payloads with it too
# hadolint ignore=DL3018
RUN apk add --no-cache \
        bash \
        git \
        grep coreutils \
        ncurses \
        just \
        jq

# bats core + extensions (bats-support / bats-assert)
COPY --from=bats-src /opt/bats /opt/bats
COPY --from=bats-src /usr/lib/bats /usr/lib/bats
COPY --from=bats-extensions /bats /usr/lib/bats

# shellcheck
COPY --from=lint-tools /usr/local/bin/shellcheck /usr/local/bin/

# distrobox (pinned; scripts only). distrobox-create locates distrobox-init /
# -export / -host-exec next to itself, so they all land in the same dir.
COPY --from=distrobox-src /opt/distrobox/bin/ /usr/local/bin/
ENV DISTROBOX_VERSION=${DISTROBOX_VERSION}

# Expose bats on PATH (alpine image keeps it under /opt/bats/bin only).
RUN ln -sf /opt/bats/bin/bats /usr/local/bin/bats

# Smoke check baked into the image so a corrupted build fails fast at CI
# rather than mid-test-run. distrobox must report exactly the pinned version;
# the just version is echoed into the build log (it is whatever alpine ships).
RUN bash --version >/dev/null && \
    bats --version >/dev/null && \
    shellcheck --version >/dev/null && \
    just --version && \
    jq --version >/dev/null && \
    [ "$(distrobox --version)" = "distrobox: ${DISTROBOX_VERSION}" ]

WORKDIR /source
ENTRYPOINT ["/bin/bash"]
