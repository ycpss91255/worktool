# Dockerfile.system-real - docker-in-docker runner for the REAL-ENGINE group
# of the system tier (M2).
#
# The plain test image (Dockerfile.test) runs the real distrobox against a
# FAKE container manager, which proves the manifest is parsed into the
# expected create request but cannot prove the box is usable. This image
# proves that: it ships a REAL docker engine (the official docker:dind image:
# dockerd + containerd + runc + docker CLI) plus bash, bats and the SAME
# pinned distrobox as Dockerfile.test (same tarball, same sha256, same
# upstream installer). script/test/system-real-entry.sh starts dockerd inside
# the container, waits for it, and runs test/system/real_engine_spec.bats,
# which assembles the delivered box/dev.ini into a real `dev` box
# (ubuntu:26.04 + ripgrep fzf tmux fish) and enters it.
#
# Since M3 issue #172 the image is Ubuntu 26.04 based rather than the
# docker:dind image itself: the ghostty chain cases need a REAL ghostty
# (packaged by 26.04 only) and a headless X server next to the real
# engine. The engine binaries and the dind helper scripts are copied in
# from the same pinned docker:dind image, so nothing about how the nested
# daemon starts changed.
#
# It MUST be started with `docker run --rm --privileged` (a nested dockerd
# needs it; see issue #129 for the DinD-vs-DooD-vs-podman decision). Every
# container / image / volume the test creates lives in the nested daemon,
# whose /var/lib/docker is an anonymous volume the dind image declares, so
# `--rm` destroys all of it with the runner: nothing the test creates reaches
# the host daemon. What the host daemon does keep is this runner image itself
# (worktool-system-real:local, plus its docker:dind base layers) and the
# Docker build cache - the same footprint as worktool-test:local.
# --privileged is used ONLY for this runner (test.sh --system-real, CI job
# test-system-real).
#
# Usage:
#   docker build -t worktool-system-real:local -f dockerfile/Dockerfile.system-real .
#   docker run --rm --privileged -v "$PWD:/source" -w /source \
#     worktool-system-real:local ./script/test/system-real-entry.sh

# Every version is pinned. DOCKER_DIND_TAG is the official docker image's
# dind variant (alpine based); its engine binaries and dind helpers are
# COPIED into the ubuntu final stage below. UBUNTU_TAG is 26.04
# (resolute), the only release whose archive ships ghostty. DISTROBOX_* is
# the single source of truth shared with Dockerfile.test (keep them
# identical).
ARG DOCKER_DIND_TAG=29.8.0-dind
ARG BATS_TAG=1.14.0
ARG ALPINE_TAG=3.24
ARG UBUNTU_TAG=26.04
ARG DISTROBOX_VERSION=1.8.2.5
ARG DISTROBOX_SHA256=0c3bc4785ee3be3b89f93abb7cc0a9f60e56989e81319af140a4b60403b18f80

FROM bats/bats:${BATS_TAG} AS bats-src

FROM alpine:${ALPINE_TAG} AS bats-extensions
# hadolint ignore=DL3018
RUN apk add --no-cache git && \
    git clone --depth 1 -b v0.3.0 \
        https://github.com/bats-core/bats-support /bats/bats-support && \
    git clone --depth 1 -b v2.1.0 \
        https://github.com/bats-core/bats-assert /bats/bats-assert

# Pinned distrobox release (identical to Dockerfile.test): fetch the tagged
# source archive, verify its checksum, install with upstream's own installer.
FROM alpine:${ALPINE_TAG} AS distrobox-src
ARG DISTROBOX_VERSION
ARG DISTROBOX_SHA256
# hadolint ignore=DL3018
RUN apk add --no-cache curl coreutils && \
    curl -fsSL -o /tmp/distrobox.tar.gz \
        "https://github.com/89luca89/distrobox/archive/refs/tags/${DISTROBOX_VERSION}.tar.gz" && \
    echo "${DISTROBOX_SHA256}  /tmp/distrobox.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/distrobox.tar.gz -C /tmp && \
    cd "/tmp/distrobox-${DISTROBOX_VERSION}" && \
    ./install --prefix /opt/distrobox

# The official docker-in-docker image, used here as a SOURCE stage: it
# brings dockerd, containerd, runc, the docker CLI and the entry helpers
# (dockerd-entrypoint.sh -> dind wrapper: cgroup v2 nesting, tmpfs /tmp,
# `mount --make-rshared /`) that the runner entry reuses instead of
# re-implementing. Every one of those binaries is a static Go build, so
# they run unchanged on the glibc final stage below; the helpers are POSIX
# shell scripts, and `/usr/local/sbin/.iptables-legacy` is a directory of
# symlinks into `/usr/sbin`, which ubuntu's iptables package fills in.
FROM docker:${DOCKER_DIND_TAG} AS docker-engine

# Final stage: Ubuntu 26.04 (resolute) rather than the docker:dind image
# itself (M3, issue #172). The ghostty chain cases of
# test/system/real_engine_spec.bats need a REAL ghostty next to the real
# engine, and ghostty is packaged by 26.04 and nothing older - alpine has
# none at all. Everything the dind image contributed is copied in below,
# so the runner entry (script/test/system-real-entry.sh) is unchanged.
FROM ubuntu:${UBUNTU_TAG}
ARG DISTROBOX_VERSION
ENV DEBIAN_FRONTEND=noninteractive
# bash          - bats, the worktool scripts and the runner entry need it
# git           - test fixtures / future harness
# coreutils/findutils/grep/sed/gawk - GNU by default here; distrobox's
#                 host-side scripts rely on GNU `base64 -w`, `realpath`,
#                 `id -r*`, `mktemp -u`, `timeout` bounds the long steps in
#                 the spec, and the dind wrapper uses `xargs` and `sed`
# util-linux    - `mount` / `mountpoint`, which the dind wrapper needs to
#                 mount securityfs, /tmp and to `--make-rshared /`
# bsdextrautils - `rev`, which distrobox-enter uses to build the command it
#                 execs. Debian/Ubuntu split it out of util-linux; busybox
#                 (the old alpine base) had it built in, so this is the one
#                 tool the rebase had to put back by name - without it every
#                 `distrobox enter` dies with `rev: not found`
# iptables      - dockerd's network setup; the package also provides the
#                 /usr/sbin/*-legacy binaries the copied
#                 /usr/local/sbin/.iptables-legacy symlinks point at
# iproute2 kmod - `ip` and `modprobe`, used by the dind entry
# e2fsprogs xz-utils pigz - what the dind image carried for the engine
# ncurses-bin   - `tput`-style terminal queries stay sane under a non-tty
#                 harness
# ghostty       - issue #172 layer 2: the real terminal under test
# xvfb xauth    - the headless X server `xvfb-run` starts for it
# dbus-x11      - `dbus-run-session`, for the single-instance fixture
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        bsdextrautils \
        ca-certificates \
        coreutils findutils grep sed gawk \
        dbus-x11 \
        e2fsprogs \
        ghostty \
        git \
        iproute2 iptables kmod \
        ncurses-bin \
        pigz \
        procps \
        util-linux \
        xauth xvfb \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# The engine and the dind helpers, exactly as the official image builds
# them (static binaries + POSIX shell wrappers + the legacy-iptables
# symlink directory).
COPY --from=docker-engine /usr/local/bin/ /usr/local/bin/
COPY --from=docker-engine /usr/local/sbin/ /usr/local/sbin/

# The dind image declares this as a volume so the nested daemon's state
# never lands in the image layer; `docker run --rm` drops it with the
# runner.
VOLUME /var/lib/docker

# bats core + extensions (bats-support / bats-assert)
COPY --from=bats-src /opt/bats /opt/bats
COPY --from=bats-src /usr/lib/bats /usr/lib/bats
COPY --from=bats-extensions /bats /usr/lib/bats

# distrobox (pinned; scripts only). distrobox-create locates distrobox-init /
# -export / -host-exec next to itself, so they all land in the same dir.
COPY --from=distrobox-src /opt/distrobox/bin/ /usr/local/bin/
ENV DISTROBOX_VERSION=${DISTROBOX_VERSION}

# The nested daemon is reached over its unix socket only: disable the dind
# image's default TLS certificate generation (DOCKER_TLS_CERTDIR=/certs) so
# no tcp listener and no cert material are set up.
ENV DOCKER_TLS_CERTDIR=

# Expose bats on PATH (the bats image keeps it under /opt/bats/bin only).
RUN ln -sf /opt/bats/bin/bats /usr/local/bin/bats

# Smoke check baked into the image so a corrupted build fails fast at build
# time rather than mid-run. distrobox must report exactly the pinned version;
# the engine binaries the entry relies on must be present.
RUN bash --version >/dev/null && \
    bats --version >/dev/null && \
    timeout --version >/dev/null && \
    dockerd --version >/dev/null && \
    docker --version >/dev/null && \
    ghostty +version >/dev/null && \
    command -v rev >/dev/null && \
    command -v xvfb-run >/dev/null && \
    command -v dbus-run-session >/dev/null && \
    [ -x /usr/local/bin/dockerd-entrypoint.sh ] && \
    [ -x /usr/local/bin/dind ] && \
    [ "$(distrobox --version)" = "distrobox: ${DISTROBOX_VERSION}" ]

WORKDIR /source
# The runner entry (script/test/system-real-entry.sh, bind-mounted with the
# repo) starts dockerd itself, so the dind image's dockerd ENTRYPOINT is
# replaced by a plain shell, matching Dockerfile.test.
ENTRYPOINT ["/bin/bash"]
